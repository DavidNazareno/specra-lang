{
  "name": "specra-lang",
  "version": "0.1.2",
  "description": "CLI for Specra contract authoring, agent guidance, and verification.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "specra-lang": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --enable-source-maps dist/index.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@specra-lang/ast": "workspace:*",
    "@specra-lang/core": "workspace:*",
    "@specra-lang/ir": "workspace:*",
    "@specra-lang/verifier": "workspace:*",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.5",
    "jsonc-parser": "^3.3.1",
    "tinyglobby": "^0.2.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4"
  }
}
