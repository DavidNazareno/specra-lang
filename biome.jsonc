{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useHtmlLang": "warn", // Not in recommended ruleset, turning on manually
        "noHeaderScope": "warn", // Not in recommended ruleset, turning on manually
        "useValidAriaRole": {
          "level": "warn",
          "options": {
            "ignoreNonDom": false,
            "allowInvalidRoles": ["none", "text"]
          }
        },
        "useSemanticElements": "off", // Rule is buggy, revisit later
        "noSvgWithoutTitle": "off", // We do not intend to adhere to this rule
        "useMediaCaption": "off", // We would need a cultural change to turn this on
        "noAutofocus": "off", // We're highly intentional about when we use autofocus
        "noBlankTarget": "off", // Covered by Conformance
        "useFocusableInteractive": "off", // Disable focusable interactive element requirement
        "useAriaPropsForRole": "off", // Disable required ARIA attributes check
        "useKeyWithClickEvents": "off" // Disable keyboard event requirement with click events
      },
      "complexity": {
        "noUselessStringConcat": "warn", // Not in recommended ruleset, turning on manually
        "noForEach": "off", // forEach is too familiar to ban
        "noUselessSwitchCase": "off", // Turned off due to developer preferences
        "noUselessThisAlias": "off", // Turned off due to developer preferences
        "noBannedTypes": "off"
      },
      "correctness": {
        "noUnusedImports": "off", // Deactivated in Astro to prevent imports used in templates from being deleted
        "useArrayLiterals": "warn", // TypeScript Standard: Use array literals
        "noNewSymbol": "warn", // TypeScript Standard: Do not use new Symbol()
        "noConstAssign": "warn", // TypeScript Standard: Do not reassign constants
        "noEmptyCharacterClassInRegex": "warn", // TypeScript Standard: No empty character classes in regex
        "noEmptyPattern": "warn", // TypeScript Standard: No empty destructuring patterns
        "noGlobalObjectCalls": "warn", // TypeScript Standard: Do not call global objects as functions
        "noInnerDeclarations": "warn", // TypeScript Standard: No inner declarations
        "noInvalidConstructorSuper": "warn", // TypeScript Standard: Valid super usage in constructors
        "noNonoctalDecimalEscape": "warn", // TypeScript Standard: No non-octal decimal escapes
        "noPrecisionLoss": "warn", // TypeScript Standard: No numeric precision loss
        "noSetterReturn": "warn", // TypeScript Standard: No return in setters
        "noSwitchDeclarations": "warn", // TypeScript Standard: No declarations in switch without blocks
        "noUndeclaredVariables": "warn", // TypeScript Standard: No undeclared variables
        "noUnreachable": "warn", // TypeScript Standard: No unreachable code
        "noUnreachableSuper": "warn", // TypeScript Standard: No unreachable super
        "noUnsafeFinally": "warn", // TypeScript Standard: No unsafe control flow in finally
        "noUnsafeOptionalChaining": "warn", // TypeScript Standard: Safe optional chaining
        "noUnusedLabels": "warn", // TypeScript Standard: No unused labels
        "noUnusedVariables": "off", // Deactivated in Astro to prevent frontmatter variables from being marked as unused
        "useIsNan": "warn", // TypeScript Standard: Use isNaN for comparisons
        "useValidForDirection": "warn", // TypeScript Standard: Valid direction in for loops
        "useYield": "warn", // TypeScript Standard: Use yield in generators
        "useJsxKeyInIterable": "off", // Rule is buggy, revisit later
        "useExhaustiveDependencies": "off", // Community feedback on this rule has been poor, we will continue with ESLint
        "noUnnecessaryContinue": "off" // Turned off due to developer preferences
      },
      "security": {
        "noDangerouslySetInnerHtml": "off" // Covered by Conformance
      },
      "style": {
        "useFragmentSyntax": "warn", // TypeScript Standard: Use Fragment syntax
        "noYodaExpression": "warn", // TypeScript Standard: No Yoda expressions
        "useDefaultParameterLast": "warn", // TypeScript Standard: Default parameters last
        "noArguments": "warn", // TypeScript Standard: Do not use arguments, use rest parameters
        "noCommaOperator": "warn", // TypeScript Standard: Do not use the comma operator
        "noImplicitBoolean": "warn", // TypeScript Standard: No implicit boolean conversions
        "noInferrableTypes": "warn", // TypeScript Standard: No explicit inferable types
        "noNamespace": "warn", // TypeScript Standard: Do not use namespace
        "noNegationElse": "warn", // TypeScript Standard: No negation in else branches
        "noNonNullAssertion": "warn", // TypeScript Standard: Avoid non-null assertions
        "noParameterAssign": "warn", // TypeScript Standard: Do not reassign parameters
        "noParameterProperties": "warn", // TypeScript Standard: No parameter properties
        "noRestrictedGlobals": "warn", // TypeScript Standard: No restricted globals
        "noShoutyConstants": "warn", // TypeScript Standard: No all-caps constants
        "noVar": "warn", // TypeScript Standard: Do not use var
        "useAsConstAssertion": "warn", // TypeScript Standard: Use as const
        "useBlockStatements": "warn", // TypeScript Standard: Use block statements
        "useCollapsedElseIf": "warn", // TypeScript Standard: Use collapsed else if
        "useConsistentArrayType": "warn", // TypeScript Standard: Consistent array type
        "useConst": "warn", // TypeScript Standard: Use const whenever possible
        "useEnumInitializers": "warn", // TypeScript Standard: Enum initializers
        "useForOf": "warn", // TypeScript Standard: Use for...of
        "useImportType": "warn", // TypeScript Standard: Use import type
        "useLiteralEnumMembers": "warn", // TypeScript Standard: Literal enum members
        "useNodejsImportProtocol": "warn", // TypeScript Standard: Node.js import protocol
        "useNumberNamespace": "warn", // TypeScript Standard: Use Number namespace
        "useNumericLiterals": "warn", // TypeScript Standard: Use numeric literals
        "useSelfClosingElements": "warn", // TypeScript Standard: Self-closing elements
        "useShorthandArrayType": "warn", // TypeScript Standard: Shorthand array type
        "useShorthandAssign": "warn", // TypeScript Standard: Shorthand assignment
        "useSingleCaseStatement": "warn", // TypeScript Standard: One statement per case
        "useSingleVarDeclarator": "warn", // TypeScript Standard: One declarator per variable
        "useTemplate": "warn", // TypeScript Standard: Use template literals
        "useWhile": "warn", // TypeScript Standard: Use while appropriately
        "useExponentiationOperator": "off", // Obscure and arguably not easily readable
        "noUnusedTemplateLiteral": "off", // Stylistic opinion
        "noUselessElse": "off" // Stylistic opinion
      },
      "suspicious": {
        "noExplicitAny": "warn", // TypeScript Standard: Avoid explicit any
        "noArrayIndexKey": "warn", // TypeScript Standard: Avoid using array indexes as keys
        "noAssignInExpressions": "warn", // TypeScript Standard: Avoid assignments in expressions
        "noAsyncPromiseExecutor": "warn", // TypeScript Standard: Avoid async Promise executors
        "noCatchAssign": "warn", // TypeScript Standard: Do not reassign catch parameters
        "noClassAssign": "warn", // TypeScript Standard: Do not reassign classes
        "noCommentText": "warn", // TypeScript Standard: Avoid text in HTML comments
        "noCompareNegZero": "warn", // TypeScript Standard: Do not compare against -0
        "noConsoleLog": "off", // Allow console.log during development
        "noControlCharactersInRegex": "warn", // TypeScript Standard: No control characters in regex
        "noDebugger": "warn", // TypeScript Standard: Do not use debugger
        "noDuplicateCase": "warn", // TypeScript Standard: No duplicate switch cases
        "noDuplicateClassMembers": "warn", // TypeScript Standard: No duplicate class members
        "noDuplicateObjectKeys": "warn", // TypeScript Standard: No duplicate object keys
        "noDuplicateParameters": "warn", // TypeScript Standard: No duplicate parameters
        "noEmptyBlockStatements": "warn", // TypeScript Standard: No empty blocks
        "noFallthroughSwitchClause": "warn", // TypeScript Standard: No switch fallthrough
        "noFunctionAssign": "warn", // TypeScript Standard: Do not reassign functions
        "noImportAssign": "warn", // TypeScript Standard: Do not reassign imports
        "noLabelVar": "warn", // TypeScript Standard: No variables named like labels
        "noMisleadingCharacterClass": "warn", // TypeScript Standard: No misleading character classes
        "noPrototypeBuiltins": "warn", // TypeScript Standard: Do not call prototype methods directly
        "noRedeclare": "warn", // TypeScript Standard: Do not redeclare variables
        "noShadowRestrictedNames": "warn", // TypeScript Standard: Do not shadow restricted names
        "noUnsafeNegation": "warn" // TypeScript Standard: No unsafe negation
      },
      "nursery": {
        "noStaticElementInteractions": "warn",
        "noHeadImportInDocument": "warn",
        "noDocumentImportInPage": "warn",
        "noDuplicateElseIf": "warn",
        "noIrregularWhitespace": "warn",
        "useValidAutocomplete": "warn"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "organizeImports": { "enabled": false },
  "files": {
    "ignore": [".nx", "generated", "generated-node", "node_modules", "**/dist"]
  }
}
