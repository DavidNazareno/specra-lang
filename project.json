{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "specra-workspace",
  "targets": {
    "lint": {
      "command": "biome check ."
    },
    "format": {
      "command": "biome format --write ."
    },
    "test": {
      "dependsOn": [
        { "projects": ["@specra-lang/ast"], "target": "build" },
        { "projects": ["@specra-lang/core"], "target": "build" },
        { "projects": ["@specra-lang/ir"], "target": "build" },
        { "projects": ["@specra-lang/verifier"], "target": "build" },
        { "projects": ["specra-lang"], "target": "build" }
      ],
      "command": "pnpm exec nx run specra-lang:build && node --test tests/**/*.test.mjs"
    }
  }
}
