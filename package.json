{
  "name": "specra-workspace",
  "version": "0.1.0",
  "description": "Specra language for contract-driven AI coding and verification.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nx run-many -t build --all --exclude specra-workspace",
    "check": "nx run-many -t check --all --exclude specra-workspace",
    "changeset": "changeset",
    "dev:cli": "pnpm --filter specra-lang dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "nx run specra-workspace:lint",
    "format": "nx run specra-workspace:format",
    "graph": "nx graph --open=false",
    "specra-lang": "node packages/cli/dist/index.js",
    "test": "nx run specra-workspace:test",
    "version-packages": "changeset version && pnpm format",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.0",
    "@nx/workspace": "^22.7.4",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "nx": "^22.7.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4"
  }
}
