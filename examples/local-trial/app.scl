service LocalTrialApp
goal: Validate a minimal Specra end-to-end flow with one real operation

entity Task
id: UUID
title: string
status: string
end

operation createTask(Task) -> Task

expectation createTask_success
operation: createTask
auth: valid
input title: "Prepare launch checklist"
expect outcome: success
expect output.status: "draft"
end

expectation createTask_requires_auth
operation: createTask
auth: missing
input title: "Prepare launch checklist"
expect outcome: unauthorized
end

constraint auth_required: true
target runtime: generic
target database: postgres
